# ⚠️ ALL VARIABLES ARE REQUIRED - NO FALLBACKS!
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# GCP and Firebase Configuration
GCP_PROJECT_ID=your-gcp-project-id
FIREBASE_STORAGE_BUCKET=your-gcp-project-id-storage

# ============================================================================
# AUTHENTICATION: Application Default Credentials (ADC)
# ============================================================================
# This application uses ADC for all GCP authentication (Firebase, Cloud Storage).
#
# One-time setup (run once per machine):
#   gcloud auth application-default login
#
# Project selection (controls which GCP project is used):
#   gcloud config set project your-gcp-project-id
#
# ADC automatically works in:
#   - Local development (uses your gcloud user credentials)
#   - Cloud Run (uses service account attached to the service)
